<?xml version="1.0" encoding="utf-8"?>
<!-- tools:layout_* only affect the Android Studio preview: roughly a 2x2 widget on Nothing Phone (2). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:layout_width="184dp"
    tools:layout_height="184dp"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot" />
    </LinearLayout>

    <TextView
        android:id="@+id/weeks_number"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|start"
        android:text="22"
        android:textColor="@color/widget_text_primary"
        android:textSize="72sp"
        android:fontFamily="@font/doto_extrabold"
        android:includeFontPadding="false"
        android:maxLines="1" />

    <TextView
        android:id="@+id/weeks_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="weeks left"
        android:textAllCaps="true"
        android:letterSpacing="0.12"
        android:textColor="@color/widget_text_primary"
        android:textSize="11sp"
        android:fontFamily="monospace" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_caption"
        android:letterSpacing="0.08"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="10sp"
        android:fontFamily="monospace" />
</LinearLayout>
