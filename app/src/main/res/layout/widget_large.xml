<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 and bigger: heading, dot, big number bottom-left, unit and due date.
     tools:layout_* only affect the Android Studio preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:layout_width="160dp"
    tools:layout_height="160dp"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="thesis"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:maxLines="1" />

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot" />
    </LinearLayout>

    <!-- Fills the free height; adjustViewBounds keeps it left-aligned at its natural width. -->
    <ImageView
        android:id="@+id/weeks_number"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitStart"
        android:src="@drawable/widget_number_preview"
        android:tint="@color/widget_text_primary" />

    <TextView
        android:id="@+id/weeks_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="weeks left"
        android:textAllCaps="true"
        android:letterSpacing="0.12"
        android:textColor="@color/widget_text_primary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:maxLines="1" />

    <TextView
        android:id="@+id/weeks_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="due 28.04.2027"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:maxLines="1" />
</LinearLayout>
