<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 layout: dot, number, unit. tools:layout_* only affect the Android Studio preview. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:layout_width="72dp"
    tools:layout_height="72dp"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:padding="10dp">

    <ImageView
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_gravity="top|end"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_dot" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- The number, drawn in code as an image in the dot-matrix font and scaled to fit. -->
        <ImageView
            android:id="@+id/weeks_number"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_number_preview"
            android:tint="@color/widget_text_primary" />

        <TextView
            android:id="@+id/weeks_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="weeks"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
